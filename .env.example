# Anthropic / Claude API key (required for AI extraction)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flask secret key — change to a long random string in production
FLASK_SECRET_KEY=change-me-to-a-random-secret-string

# Set to "true" to enable Flask debug mode (development only)
FLASK_DEBUG=false

# Port for the development server (default 5000)
PORT=5000
